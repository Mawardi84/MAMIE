# MAMIE Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# API Keys (Optional)
# ============================================

# FRED API Key (Federal Reserve Economic Data)
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
VITE_FRED_API_KEY=DEMO_KEY

# OpenAI API Key (for AI features)
# Get your key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# ============================================
# Feature Flags
# ============================================

# Enable WebSocket for real-time data updates
VITE_ENABLE_WEBSOCKET=false

# Enable AI-powered insights and analysis
VITE_ENABLE_AI_INSIGHTS=false

# Enable real-time data streaming
VITE_ENABLE_REAL_TIME_DATA=false

# ============================================
# API Configuration
# ============================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001

# Primary data source (yahoo, alpha_vantage, polygon)
VITE_DATA_SOURCE=yahoo

# ============================================
# Environment
# ============================================

# Current environment (development, staging, production)
VITE_ENVIRONMENT=development

# Enable debug mode (shows additional logging)
VITE_DEBUG=true

# ============================================
# Analytics (Optional)
# ============================================

# Google Analytics ID
VITE_GA_ID=

# Sentry DSN for error tracking
VITE_SENTRY_DSN=
