# Backend API Configuration
# Set this to your backend URL to use tvdatafeed
# Leave empty to use Yahoo Finance via CORS proxy (less reliable)
VITE_API_BASE=http://localhost:8000

# Optional: TradingView Credentials (configured in backend/.env)
# Not needed in frontend, backend handles authentication

# Optional: Other API Keys
VITE_FRED_API_KEY=DEMO_KEY
VITE_OPENAI_API_KEY=

# Feature Flags
VITE_ENABLE_WEBSOCKET=false
VITE_ENABLE_AI_INSIGHTS=false
VITE_ENABLE_REAL_TIME_DATA=false

# Environment
VITE_ENVIRONMENT=development
VITE_DEBUG=true
